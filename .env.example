# blisolver configuration — copy to `.env` and fill in. NEVER commit the real `.env`.
#
# Every variable below is read by the code. `blisolver doctor` reports which stages are ready and
# names the variable that gates each one, so run it rather than guessing.

# --- Vision: LM Studio (OpenAI-compatible endpoint) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_VISION_MODEL=

# --- Local ASR: whisper.cpp ---
# Neither of these is a Python package; they are an external binary and a weights file, which is
# why there is no `transcribe` extra. doctor checks them separately — having the binary says
# nothing about having the model.
# BLISOLVER_WHISPER_CLI=whisper-cli
# Default is /tmp/ggml-medium.bin, which is cleared on reboot. Point this at a durable path.
# Fetch with: curl -sL -o <path> \
#   https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-medium.bin
# BLISOLVER_WHISPER_MODEL=/tmp/ggml-medium.bin

# --- Danmaku (bilibili --danmaku) ---
# Without a model, --danmaku is accepted on the command line and then ignored at runtime.
# BLISOLVER_DANMAKU_MODEL=
# BLISOLVER_DANMAKU_MAX_TOKENS=8192
# BLISOLVER_DANMAKU_WINDOW_S=15
# BLISOLVER_DANMAKU_MD_CAP=15

# --- bilibili auth (D9) ---
# Default: yt-dlp reads cookies live from your logged-in browser (BLISOLVER_COOKIES_* below).
# Fallback (headless / no browser): paste a SESSDATA cookie value here.
# bilibili exposes its AI subtitle tracks only to a logged-in session, so a cold profile degrades
# every bilibili video to Whisper.
# SESSDATA=

# --- Cookies-from-browser (D9 default; also unlocks age-gated YouTube when set) ---
# chrome is the default; on Windows switch to firefox (Chromium DPAPI-encrypts the cookie DB).
BLISOLVER_COOKIES_BROWSER=chrome
BLISOLVER_COOKIES_PROFILE=

# --- YouTube ---
# Off by default: a logged-in session breaks yt-dlp's format selection (issue #1). Opt in only for
# age-gated or bot-checked content.
# BLISOLVER_YT_COOKIES=0

# --- Where generated state goes ---
# Resolution order: BLISOLVER_CACHE_DIR / BLISOLVER_OUT_DIR, then BLISOLVER_DATA_DIR/{cache,out},
# then PLUGIN_DATA/{cache,out} supplied by an Agent Plugins client, then <repo>/{cache,out}.
# A plugin client points this outside the package so bundles survive an update.
# BLISOLVER_DATA_DIR=
# BLISOLVER_CACHE_DIR=cache
# BLISOLVER_OUT_DIR=out

# --- Hard-subtitle OCR (--ocr), isolated so RapidOCR/OpenCV stay out of the main environment ---
# Set up with: uv venv .ocr-venv && .ocr-venv/bin/pip install rapidocr-onnxruntime opencv-python
# Autodetected at <repo>/scripts/ocr_worker.py and <repo>/.ocr-venv/bin/python; these override.
# BLISOLVER_OCR_WORKER=
# BLISOLVER_OCR_VENV_PYTHON=
# Tuning dials, calibrated on a 261s burned-in-sub test video:
# BLISOLVER_OCR_FPS=2.0
# BLISOLVER_OCR_MIN_CONF=0.50
# BLISOLVER_OCR_SIM_THRESHOLD=0.80
# BLISOLVER_OCR_DIFF_THRESHOLD=6.0
# BLISOLVER_OCR_DETECT_INTERVAL=30.0

# --- Interpreter selection (used by bin/blisolver-mcp and the skill's scripts) ---
# Overrides the search order: $PLUGIN_DATA/venv/bin/python, then <plugin-root>/.venv/bin/python,
# then an installed `blisolver` on PATH.
# BLISOLVER_PYTHON=

# --- Tool discovery ---
# ffmpeg is found on PATH; set this when it lives somewhere unusual.
# FFMPEG_PATH=
